# --- Database (SQLite) ---
# Игнорируем сам файл базы данных, так как он бинарный и меняется часто.
# Структура создается кодом при запуске, данные переносить через Git не нужно.
*.sqlite
*.sqlite3
*.db

# --- Environment Variables ---
# Никогда не заливай ключи и пароли!
.env
.env.local
.env.*.local

# --- Build Outputs (Frontend) ---
# Папки сборки фронтенда
dist/
build/
out/

# --- OS & IDE Files ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

